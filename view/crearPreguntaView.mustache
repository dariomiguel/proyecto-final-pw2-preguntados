{{>header}}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    {{#esAdmin}}
                        <h2 class="card-title mb-4 text-center">Crear pregunta</h2>
                    {{/esAdmin}}
                    {{^esAdmin}}
                        <h2 class="card-title mb-4 text-center">Sugerir pregunta</h2>
                    {{/esAdmin}}

                    {{#enviada}}
                    <div class="alert alert-success" role="alert">
                        Tu pregunta fue enviada y está pendiente de revisión. ¡Gracias por tu aporte!
                    </div>
                    {{/enviada}}

                    <form action="/pregunta/guardar" method="POST" novalidate>
                        <div class="row g-3">

                            <div class="col-12">
                                <label class="form-label">Enunciado *</label>
                                <textarea name="enunciado" rows="3"
                                          class="form-control {{#errores.enunciado}}is-invalid{{/errores.enunciado}}">{{datos.enunciado}}</textarea>
                                {{#errores.enunciado}}<div class="invalid-feedback">{{errores.enunciado}}</div>{{/errores.enunciado}}
                            </div>

                            <div class="col-12">
                                <label class="form-label">Categoría *</label>
                                <select name="categoria_id" class="form-select {{#errores.categoria_id}}is-invalid{{/errores.categoria_id}}">
                                    <option value="">Seleccioná una categoría</option>
                                    {{#categorias}}
                                        <option value="{{id}}" {{#seleccionada}}selected{{/seleccionada}}>{{nombre}}</option>
                                    {{/categorias}}
                                </select>
                                {{#errores.categoria_id}}<div class="invalid-feedback">{{errores.categoria_id}}</div>{{/errores.categoria_id}}
                            </div>

                            <div class="col-12">
                                <label class="form-label">Respuestas *</label>
                                <p class="text-muted small mb-2">Escribí las 4 opciones y marcá cuál es la correcta.</p>
                                {{#errores.respuestas}}<div class="text-danger small mb-2">{{errores.respuestas}}</div>{{/errores.respuestas}}

                                <div class="input-group mb-2">
                                    <div class="input-group-text">
                                        <input type="radio" name="correcta" value="1" required>
                                    </div>
                                    <input type="text" name="respuesta_1" class="form-control {{#errores.respuesta_1}}is-invalid{{/errores.respuesta_1}}" placeholder="Opción 1" value="{{datos.respuesta_1}}">
                                    {{#errores.respuesta_1}}<div class="invalid-feedback">{{errores.respuesta_1}}</div>{{/errores.respuesta_1}}
                                </div>

                                <div class="input-group mb-2">
                                    <div class="input-group-text">
                                        <input type="radio" name="correcta" value="2">
                                    </div>
                                    <input type="text" name="respuesta_2" class="form-control {{#errores.respuesta_2}}is-invalid{{/errores.respuesta_2}}" placeholder="Opción 2" value="{{datos.respuesta_2}}">
                                    {{#errores.respuesta_2}}<div class="invalid-feedback">{{errores.respuesta_2}}</div>{{/errores.respuesta_2}}
                                </div>

                                <div class="input-group mb-2">
                                    <div class="input-group-text">
                                        <input type="radio" name="correcta" value="3">
                                    </div>
                                    <input type="text" name="respuesta_3" class="form-control {{#errores.respuesta_3}}is-invalid{{/errores.respuesta_3}}" placeholder="Opción 3" value="{{datos.respuesta_3}}">
                                    {{#errores.respuesta_3}}<div class="invalid-feedback">{{errores.respuesta_3}}</div>{{/errores.respuesta_3}}
                                </div>

                                <div class="input-group mb-2">
                                    <div class="input-group-text">
                                        <input type="radio" name="correcta" value="4">
                                    </div>
                                    <input type="text" name="respuesta_4" class="form-control {{#errores.respuesta_4}}is-invalid{{/errores.respuesta_4}}" placeholder="Opción 4" value="{{datos.respuesta_4}}">
                                    {{#errores.respuesta_4}}<div class="invalid-feedback">{{errores.respuesta_4}}</div>{{/errores.respuesta_4}}
                                </div>

                                {{#errores.correcta}}<div class="text-danger small">{{errores.correcta}}</div>{{/errores.correcta}}
                            </div>

                            <div class="col-12 mt-2">
                                {{#esAdmin}}
                                    <button type="submit" class="btn btn-primary w-100">Crear pregunta</button>
                                {{/esAdmin}}
                                {{^esAdmin}}
                                    <button type="submit" class="btn btn-primary w-100">Enviar sugerencia</button>
                                {{/esAdmin}}
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{{>footer}}
