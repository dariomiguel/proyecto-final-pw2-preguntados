{{> header}}

<div class="login-wrapper d-flex align-items-center justify-content-center min-vh-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">

                <!-- Logo -->
                <div class="text-center mb-4">
                    <div class="brand-icon mb-3">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h1 class="brand-title">Preguntados.UNLaM</h1>
                    <p class="brand-subtitle">Ingresá a tu cuenta</p>
                </div>

                <!-- Card del formulario -->
                <div class="card login-card shadow-lg border-0">
                    <div class="card-body p-4 p-md-5">

                        <form action="" method="POST" novalidate>

                            <!-- Usuario -->
                            <div class="mb-3">
                                <label for="username" class="form-label fw-semibold">
                                    <i class="bi bi-person me-1"></i>Usuario
                                </label>
                                <input
                                        type="text"
                                        class="form-control form-control-lg"
                                        id="username"
                                        name="username"
                                        placeholder="Tu nombre de usuario"
                                        autocomplete="username"
                                        required
                                >
                            </div>

                            <!-- Contraseña -->
                            <div class="mb-4">
                                <label for="password" class="form-label fw-semibold">
                                    <i class="bi bi-lock me-1"></i>Contraseña
                                </label>
                                <div class="input-group">
                                    <input
                                            type="password"
                                            class="form-control form-control-lg"
                                            id="password"
                                            name="password"
                                            placeholder="Tu contraseña"
                                            autocomplete="current-password"
                                            required
                                    >
                                    <button
                                            class="btn btn-outline-secondary"
                                            type="button"
                                            id="togglePassword"
                                            title="Mostrar/ocultar contraseña"
                                    >
                                        <i class="bi bi-eye" id="eyeIcon"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Botón -->
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary btn-lg fw-semibold">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
                                </button>
                            </div>

                        </form>
                        <div class="d-grid mt-2">
                            <a href="/registrar" class="btn btn-secondary btn-lg fw-semibold">Registrarse</a>
                        </div>
                        <a href="/index.php?controller=registrar&method=ver">
                            Registrarse
                        </a>
                    </div>
                </div>

                <p class="text-center mt-4 text-muted small">
                    &copy; 2026 - Preguntados.UNLaM
                </p>

            </div>
        </div>
    </div>
</div>

<script>
    // Toggle mostrar/ocultar contraseña
    document.getElementById('togglePassword').addEventListener('click', function () {
        const input   = document.getElementById('password');
        const eyeIcon = document.getElementById('eyeIcon');
        const isPass  = input.type === 'password';
        input.type    = isPass ? 'text' : 'password';
        eyeIcon.className = isPass ? 'bi bi-eye-slash' : 'bi bi-eye';
    });
</script>

{{> footer}}
