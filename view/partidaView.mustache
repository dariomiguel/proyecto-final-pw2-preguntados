{{>header}}
<main class="flex-grow-1" style="background-color: {{color_categoria_sec}};">
    {{#yaVistaTodas}}
        <p><i class="bi bi-check-circle-fill"></i> Esta pregunta ya la viste.</p>
    {{/yaVistaTodas}}

    <div class="container my-5 d-flex justify-content-center">
        <div class="row w-100 justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card shadow-lg p-4 text-center border-0 text-dark"
                     id="contenedor-trivia"
                     style="background-color: {{color_categoria}}; border-radius: 20px;">

                    <div class="mb-2 text-uppercase fw-bold small text-dark opacity-75">
                        Categoría: {{nombre_categoria}}
                    </div>

                    <!-- ⏱️ CRONÓMETRO -->
                    <div class="d-flex justify-content-center mb-3">
                        <div class="position-relative" style="width: 90px; height: 90px;">
                            <svg width="90" height="90" viewBox="0 0 90 90"
                                 class="position-absolute top-0 start-0"
                                 style="transform: rotate(-90deg);">
                                <circle cx="45" cy="45" r="38"
                                        fill="none"
                                        stroke="rgba(0,0,0,0.12)"
                                        stroke-width="6"/>
                                <circle id="timer-ring"
                                        cx="45" cy="45" r="38"
                                        fill="none"
                                        stroke="rgba(0,0,0,0.7)"
                                        stroke-width="6"
                                        stroke-linecap="round"
                                        stroke-dasharray="238.76"
                                        stroke-dashoffset="0"
                                        style="transition: stroke-dashoffset 1s linear;"/>
                            </svg>
                            <div class="position-absolute top-0 start-0 w-100 h-100
                                        d-flex flex-column align-items-center justify-content-center">
                                <span id="timer-display"
                                      class="fw-bold text-dark"
                                      style="font-size: 1.6rem; line-height: 1;">15</span>
                                <span class="text-dark opacity-50"
                                      style="font-size: 0.65rem;">seg</span>
                            </div>
                        </div>
                    </div>
                    <!-- /CRONÓMETRO -->

                    <h2 class="h3 fw-bold mb-4 text-dark">
                        {{enunciado}}
                    </h2>

                    <hr class="border-dark opacity-25 mb-4">

                    <div class="d-grid gap-3">
                        {{#respuestas}}
                            <form action="/partida/validarRespuesta" method="POST">
                                <input type="hidden" name="id_pregunta" value="{{pregunta_id}}">
                                <button type="submit"
                                        name="respuesta_id"
                                        value="{{id}}"
                                        class="btn btn-light btn-outline-info btn-lg w-100 py-3 text-start px-4 border-2 shadow-sm text-dark">
                                    {{texto}}
                                </button>
                            </form>
                        {{/respuestas}}
                    </div>

                    <div class="mt-4 text-center">
                        <button type="button"
                                class="btn btn-sm btn-link text-muted text-decoration-none small">
                            🏳️ Reportar pregunta inválida
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
<script>
    window.TIMER_RESTANTE = {{timer_restante}};
</script>
<script src="../public/js/partidaView.js"></script>

{{>footer}}