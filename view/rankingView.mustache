{{>header}}

<div class="container my-5" style="max-width: 800px;">
    <div class="card shadow bg-dark text-white p-4 rounded-3">
        <h2 class="text-center mb-4 fw-bold text-info">🏆 Ranking Global</h2>
        <p class="text-muted text-center small mb-4">Los mejores jugadores de la plataforma actualizados en tiempo real.</p>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                <tr class="text-info border-secondary">
                    <th scope="col" class="text-center" style="width: 10%">Puesto</th>
                    <th scope="col" style="width: 50%">Jugador</th>
                    <th scope="col" class="text-end" style="width: 40%">Puntaje Total</th>
                </tr>
                </thead>
                <tbody>
                {{#usuarios}}
                    <tr class="border-secondary">
                        <td class="text-center fw-bold text-warning">
                            {{puesto}}
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="/public/uploads/{{foto_perfil}}"
                                     alt="Foto de @{{nombre_usuario}}"
                                     class="rounded-circle border border-secondary"
                                     style="width: 40px; height: 40px; object-fit: cover;">

                                <a href="/perfil/verPublico?nombre={{nombre_usuario}}" class="text-white text-decoration-none fw-semibold">
                                @{{nombre_usuario}}
                                </a>
                            </div>
                        </td>
                        <td class="text-end fw-bold text-success">
                            {{puntaje_total}} pts
                        </td>
                    </tr>
                {{/usuarios}}

                {{^usuarios}}
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">No hay jugadores registrados en el ranking aún.</td>
                    </tr>
                {{/usuarios}}
                </tbody>
            </table>
        </div>

        <div class="mt-4 text-center">
            <a href="/lobby" class="btn btn-secondary btn-sm px-4 fw-bold shadow-sm">Volver al Lobby</a>
        </div>
    </div>
</div>

{{>footer}}