{{>header}}

<link rel="stylesheet" href="/public/css/ruleta-style.css">

<main class="app">
    <div class="title">
        <h1>A jugar!!</h1>
        <p>Girá la ruleta para elegir categoría.</p>
    </div>
    <section class="wheel-shell" aria-label="Ruleta interactiva">
        <div class="pointer" aria-hidden="true"></div>
        <canvas id="wheel" width="900" height="900"></canvas>
        <button id="spinBtn" class="spin-btn" aria-label="Girar ruleta">
            GIRAR
            <span class="small">¡Suerte!</span>
        </button>
    </section>
</main>
<div id="modal" class="ruleta-modal" role="dialog" aria-modal="true"
     aria-labelledby="modalTitle" aria-describedby="modalDesc">
    <div class="modal-card">
        <h2 id="modalTitle">Resultado</h2>
        <p id="modalDesc">La ruleta se detuvo en:</p>
        <div id="resultBadge" class="result-badge">Opción 1</div>
        <a id="closeModal" href="/partida/jugar" class="close-btn">Aceptar</a>
    </div>
</div>

<script>
    window.RULETA_STATE = {
        categorias: {{{categorias_json}}},
        categoriaFijada: {{#categoriaFijada}}true{{/categoriaFijada}}{{^categoriaFijada}}false{{/categoriaFijada}},
        indiceRuleta:    {{#categoriaFijada}}{{indiceRuletaFijado}}{{/categoriaFijada}}{{^categoriaFijada}}null{{/categoriaFijada}},
        nombreCategoria: "{{#categoriaFijada}}{{nombreCategoriaFijada}}{{/categoriaFijada}}"
    };
</script>

<script src="/public/js/ruletaDatos.js"></script>
<script src="/public/js/ruletaDibujo.js"></script>
<script src="/public/js/ruletaAnimacion.js"></script>
<script src="/public/js/mostrarRuleta.js"></script>

{{>footer}}
