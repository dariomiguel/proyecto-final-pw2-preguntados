{{>header}}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="card-title mb-4 text-center">Crear cuenta</h2>

                    <form action="/registro/procesar" method="POST" enctype="multipart/form-data" novalidate>
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label">Nombre *</label>
                                <input type="text" name="nombre" class="form-control {{#errores.nombre}}is-invalid{{/errores.nombre}}" value="{{datos.nombre}}">
                                {{#errores.nombre}}<div class="invalid-feedback">{{errores.nombre}}</div>{{/errores.nombre}}
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Segundo nombre</label>
                                <input type="text" name="segundo_nombre" class="form-control" value="{{datos.segundo_nombre}}">
                            </div>

                            <div class="col-12">
                                <label class="form-label">Apellido *</label>
                                <input type="text" name="apellido" class="form-control {{#errores.apellido}}is-invalid{{/errores.apellido}}" value="{{datos.apellido}}">
                                {{#errores.apellido}}<div class="invalid-feedback">{{errores.apellido}}</div>{{/errores.apellido}}
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Año de nacimiento *</label>
                                <input type="number" name="anio_nacimiento" class="form-control {{#errores.anio_nacimiento}}is-invalid{{/errores.anio_nacimiento}}" value="{{datos.anio_nacimiento}}" min="1900" max="2025">
                                {{#errores.anio_nacimiento}}<div class="invalid-feedback">{{errores.anio_nacimiento}}</div>{{/errores.anio_nacimiento}}
                            </div>

                            <div class="col-md-6">
                                <label class="form-label d-block">Sexo *</label>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="sexo" value="Masculino" id="sexoM">
                                    <label class="form-check-label" for="sexoM">Masculino</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="sexo" value="Femenino" id="sexoF">
                                    <label class="form-check-label" for="sexoF">Femenino</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="sexo" value="Prefiero no cargarlo" id="sexoN">
                                    <label class="form-check-label" for="sexoN">Prefiero no cargarlo</label>
                                </div>
                                {{#errores.sexo}}<div class="text-danger small mt-1">{{errores.sexo}}</div>{{/errores.sexo}}
                            </div>

<!--                            <div class="col-md-6">-->
<!--                                <label class="form-label">País *</label>-->
<!--                                <input type="text" name="pais" class="form-control {{#errores.pais}}is-invalid{{/errores.pais}}" value="{{datos.pais}}">-->
<!--                                {{#errores.pais}}<div class="invalid-feedback">{{errores.pais}}</div>{{/errores.pais}}-->
<!--                            </div>-->

<!--                            <div class="col-md-6">-->
<!--                                <label class="form-label">Ciudad *</label>-->
<!--                                <input type="text" name="ciudad" class="form-control {{#errores.ciudad}}is-invalid{{/errores.ciudad}}" value="{{datos.ciudad}}">-->
<!--                                {{#errores.ciudad}}<div class="invalid-feedback">{{errores.ciudad}}</div>{{/errores.ciudad}}-->
<!--                            </div>-->

                            <div class="col-12">
                                <label class="form-label">Ubicación * <small class="text-muted">(hacé click en el mapa)</small></label>
                                <div class="input-group mb-2">
                                    <input type="text" id="buscadorMapa" class="form-control" placeholder="Buscá tu ciudad...">
                                    <button type="button" class="btn btn-outline-secondary" onclick="buscarUbicacion()">Buscar</button>
                                </div>
                                <div id="mapa" style="height: 300px; border-radius: 8px;" class="mb-2"></div>
                                {{#errores.latitud}}<div class="text-danger small">{{errores.latitud}}</div>{{/errores.latitud}}
                                <input type="hidden" name="latitud"  id="latitud"  value="{{datos.latitud}}">
                                <input type="hidden" name="longitud" id="longitud" value="{{datos.longitud}}">
                                <div class="row g-2 mt-1">
                                    <div class="col-md-6">
                                        <input type="text" name="pais" id="pais" placeholder="País *"
                                               class="form-control {{#errores.pais}}is-invalid{{/errores.pais}}"
                                               value="{{datos.pais}}" readonly>
                                        {{#errores.pais}}<div class="invalid-feedback">{{errores.pais}}</div>{{/errores.pais}}
                                    </div>
                                    <div class="col-md-6">
                                        <input type="text" name="ciudad" id="ciudad" placeholder="Ciudad *"
                                               class="form-control {{#errores.ciudad}}is-invalid{{/errores.ciudad}}"
                                               value="{{datos.ciudad}}" readonly>
                                        {{#errores.ciudad}}<div class="invalid-feedback">{{errores.ciudad}}</div>{{/errores.ciudad}}
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Mail *</label>
                                <input type="email" name="mail" class="form-control {{#errores.mail}}is-invalid{{/errores.mail}}" value="{{datos.mail}}">
                                {{#errores.mail}}<div class="invalid-feedback">{{errores.mail}}</div>{{/errores.mail}}
                            </div>

                            <div class="col-12">
                                <label class="form-label">Contraseña *</label>
                                <input type="password" name="contrasenia" class="form-control {{#errores.contrasenia}}is-invalid{{/errores.contrasenia}}">
                                {{#errores.contrasenia}}<div class="invalid-feedback">{{errores.contrasenia}}</div>{{/errores.contrasenia}}
                            </div>

<!--                            <div class="col-md-6">-->
<!--                                <label class="form-label">Repetir contraseña *</label>-->
<!--                                <input type="password" name="repetir_contrasenia" class="form-control {{#errores.repetir_contrasenia}}is-invalid{{/errores.repetir_contrasenia}}">-->
<!--                                {{#errores.repetir_contrasenia}}<div class="invalid-feedback">{{errores.repetir_contrasenia}}</div>{{/errores.repetir_contrasenia}}-->
<!--                            </div>-->

                            <div class="col-12">
                                <label class="form-label">Nombre de usuario *</label>
                                <input type="text" name="nombre_usuario" class="form-control {{#errores.nombre_usuario}}is-invalid{{/errores.nombre_usuario}}" value="{{datos.nombre_usuario}}">
                                {{#errores.nombre_usuario}}<div class="invalid-feedback">{{errores.nombre_usuario}}</div>{{/errores.nombre_usuario}}
                            </div>

                            <div class="col-12">
                                <label class="form-label">Foto de perfil</label>
                                <input type="file" name="foto_perfil" class="form-control {{#errores.foto_perfil}}is-invalid{{/errores.foto_perfil}}" accept="image/jpeg,image/png,image/gif">
                                <div class="form-text">JPG, PNG o GIF. Máximo 2MB.</div>
                                {{#errores.foto_perfil}}<div class="invalid-feedback">{{errores.foto_perfil}}</div>{{/errores.foto_perfil}}
                            </div>

                            <div class="col-12 mt-2">
                                <button type="submit" class="btn btn-primary w-100">Registrarse</button>
                            </div>
                            <div class="col-12 text-center">
                                <small>¿Ya tenés cuenta? <a href="/login/ver">Iniciá sesión</a></small>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    const latInicial = parseFloat(document.getElementById('latitud').value) || -34.6;
    const lngInicial = parseFloat(document.getElementById('longitud').value) || -58.4;
    const mapa = L.map('mapa').setView([latInicial, lngInicial], 5);
    let marcador = null;

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
    }).addTo(mapa);

    if (document.getElementById('latitud').value) {
        marcador = L.marker([latInicial, lngInicial]).addTo(mapa);
    }

    function actualizarCampos(lat, lon) {
        document.getElementById('latitud').value  = parseFloat(lat).toFixed(8);
        document.getElementById('longitud').value = parseFloat(lon).toFixed(8);
        fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lon}&format=json`)
                .then(r => r.json())
                .then(d => {
                    const addr = d.address;
                    document.getElementById('pais').value   = addr.country || '';
                    document.getElementById('ciudad').value = addr.city || addr.town || addr.village || addr.county || '';
                });
    }

    mapa.on('click', function(e) {
        const { lat, lng } = e.latlng;
        if (marcador) marcador.remove();
        marcador = L.marker([lat, lng]).addTo(mapa);
        actualizarCampos(lat, lng);
    });

    function buscarUbicacion() {
        const query = document.getElementById('buscadorMapa').value;
        if (!query) return;
        fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&format=json&limit=1`)
                .then(r => r.json())
                .then(data => {
                    if (data.length === 0) return alert('No se encontró la ubicación');
                    const lat = data[0].lat;
                    const lon = data[0].lon;
                    mapa.setView([lat, lon], 13);
                    if (marcador) marcador.remove();
                    marcador = L.marker([lat, lon]).addTo(mapa);
                    actualizarCampos(lat, lon);
                });
    }
</script>
{{>footer}}