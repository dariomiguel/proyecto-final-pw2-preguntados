<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lobby - Preguntados.UNLaM</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

</head>
<body>

<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="/lobby">Preguntados.UNLaM</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNavegacion" aria-controls="menuNavegacion" aria-expanded="false" aria-label="Alternar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuNavegacion">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    {{^sesionIniciada}}
                        <li class="nav-item">
                            <a class="nav-link" href="/login">Iniciar Sesión</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/registro">Registrarse</a>
                        </li>
                    {{/sesionIniciada}}
                    {{#sesionIniciada}}
                        {{#esAdmin}}
                        <li class="nav-item">
                            <a class="nav-link" href="/pregunta/pendientes">Preguntas pendientes</a>
                        </li>
                        {{/esAdmin}}
                        {{^esAdmin}}
                        <li class="nav-item">
                            <a class="nav-link" href="/pregunta/ver">Sugerir Pregunta</a>
                        </li>
                        {{/esAdmin}}
                        <li class="nav-item d-none d-lg-block">
                            <span class="nav-link text-secondary">|</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="/perfil/ver?nombre={{nombre_usuario}}">Perfil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/login/logout">Cerrar sesión</a>
                        </li>
                    {{/sesionIniciada}}
                </ul>
            </div>
        </div>
    </nav>
</header>