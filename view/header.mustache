<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lobby - Juego de Preguntas</title>

    <style>
        /* --- ESTILOS GENERALES --- */
        body {
            font-family: sans-serif;
            background-color: #f4f4f9;
            margin: 0;
            padding: 20px;
        }
        main {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            background: white;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            border-radius: 8px;
        }

        /* --- ENCABEZADO --- */
        header {
            text-align: center;
            border-bottom: 2px solid #ccc;
            padding-bottom: 20px;
        }
        header h1 { color: #333; margin-bottom: 5px; }
        header h2 { color: #666; font-weight: normal; margin-top: 0; }

        /* --- BOTONERA --- */
        .botonera {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin: 30px 0;
        }
        .btn {
            padding: 15px 30px;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
            transition: background-color 0.3s;
        }
        .btn-nueva { background-color: #28a745; }
        .btn-nueva:hover { background-color: #218838; }

        .btn-ranking { background-color: #007bff; }
        .btn-ranking:hover { background-color: #0069d9; }

        /* --- HISTORIAL DE PARTIDAS --- */
        .historial { margin-top: 20px; }
        .historial h3 { color: #333; }
        .historial ul {
            list-style-type: none;
            padding: 0;
        }
        .historial li {
            background: #eee;
            margin-bottom: 10px;
            padding: 15px;
            border-radius: 4px;
            border-left: 4px solid #333;
        }
    </style>
</head>
<body>
