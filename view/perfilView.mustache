{{>header}}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body text-center">

                    {{#mensaje_exito}}
                        <div class="alert alert-success bg-success bg-opacity-10 text-success border-success small py-2 mb-3" role="alert">
                            ✅ {{mensaje_exito}}
                        </div>
                    {{/mensaje_exito}}

                    <img src="/public/uploads/{{foto_perfil}}"
                         alt="Foto de {{nombre_usuario}}"
                         class="rounded-circle img-thumbnail mb-3"
                         style="width: 150px; height: 150px; object-fit: cover;">

                    <h2 class="card-title">{{nombre}} {{apellido}}</h2>
                    <p class="text-muted">@{{nombre_usuario}}</p>

                    {{#usuario_logueado}}
                        <div class="mb-3">
                            <a href="/perfil/editarPerfil" class="btn btn-sm btn-outline-secondary">
                                ⚙️ Editar Perfil
                            </a>
                        </div>
                    {{/usuario_logueado}}

                    <div class="row mt-4 justify-content-center">
                        <div class="col-sm-6 mb-4 d-flex flex-column align-items-center justify-content-center">
                            <h4 class="display-4 fw-bold mb-0">{{puntaje_total}}</h4>
                            <small class="text-muted text-uppercase fw-semibold">Puntaje Total</small>
                        </div>

                        <div class="col-sm-6 mb-4 d-flex justify-content-center">
                            <div class="bg-white p-3 border shadow-sm rounded" style="max-width: 180px;">
                                <img src="{{{url_qr}}}" alt="Código QR del perfil" class="img-fluid">
                                <p class="small text-dark mt-2 mb-0">Compartí tu perfil con este código QR</p>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <h5 class="card-title">Información Personal</h5>

                    <div class="card bg-light border-0 mx-auto mb-4" style="max-width: 450px;">
                        <ul class="list-group list-group-flush bg-transparent">
                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center py-3 border-bottom">
                                <span class="text-dark small">Email:</span>
                                <span class="text-dark fw-bold text-end text-truncate ms-2" style="max-width: 260px;">{{mail}}</span>
                            </li>
                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center py-3 border-bottom">
                                <span class="text-dark small">Ubicación:</span>
                                <span class="text-dark fw-bold text-end">{{ciudad}}, {{pais}}</span>
                            </li>
                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center py-3 border-bottom">
                                <span class="text-dark small">Sexo:</span>
                                <span class="text-dark fw-bold text-end">{{sexo}}</span>
                            </li>
                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center py-3 border-0">
                                <span class="text-dark small">Año de Nacimiento:</span>
                                <span class="text-dark fw-bold text-end">{{anio_nacimiento}}</span>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-4 text-center">
                        <a href="/lobby" class="btn btn-outline-primary px-4 btn-sm">Volver al Lobby</a>
                    </div>

{{>footer}}